#!/bin/sh
# Bloquea archivos de entorno y patrones de secreto en lo que se va a commitear.
# Activación: git config core.hooksPath .githooks

status=0

env_files=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env($|\.)' | grep -v '\.env\.example$')
if [ -n "$env_files" ]; then
  echo "pre-commit: archivo de entorno bloqueado:" >&2
  echo "$env_files" | sed 's/^/  /' >&2
  status=1
fi

# Solo líneas añadidas; se omite el propio hook para que sus patrones no se detecten a sí mismos.
added=$(git diff --cached -U0 --diff-filter=ACMR -- . ':(exclude).githooks/*' | grep -E '^\+[^+]')

patterns='-----BEGIN [A-Z ]*PRIVATE KEY-----
AKIA[0-9A-Z]{16}
gh[pousr]_[A-Za-z0-9]{36,}
xox[baprs]-[A-Za-z0-9-]{10,}
eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}
(JWT_(ACCESS|REFRESH)_SECRET|DB_PASSWORD|MYSQL_(ROOT_)?PASSWORD|AUTOMATION_API_KEY|N8N_WEBHOOK_SECRET)[[:space:]]*[:=][[:space:]]*[A-Za-z0-9+/=_-]{12,}'

echo "$patterns" | while IFS= read -r pattern; do
  match=$(echo "$added" | grep -E -- "$pattern" | grep -vE 'change-me|placeholder|<[a-z_-]+>|\$\{')
  if [ -n "$match" ]; then
    echo "pre-commit: posible secreto (patrón: $pattern). Valor no mostrado." >&2
    exit 1
  fi
done || status=1

if [ "$status" -ne 0 ]; then
  echo "pre-commit: commit bloqueado. Quita el secreto o usa variables de entorno." >&2
fi
exit $status
